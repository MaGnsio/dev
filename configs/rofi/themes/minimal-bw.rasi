configuration {
  font: "JetBrainsMono Nerd Font Bold 14";
  modes: [window, drun, run, ssh];
  drun {
    display-name: "🔎︎";
    placeholder: "ji";
  }
  run {
    display-name: "👻";
  }
  window {
    display-name: "🗖";
  }
  ssh {
    display-name: "🔐";
  }
  timeout {
    delay: 20;
    action: "kb-cancel";
  }
}

* {
  black: #000000;
  white: #FFFFFF;
  gray: #a9b1d6;

  margin: 0px;
  padding: 0px;
  spacing: 0px;

  background-color: @black;
  text-color: @white;
}

window {
  width: 480;
  border: 2px;
  border-radius: 24px;
  border-color: @white;
}

mainbox {
  padding: 12px;
  children: [inputbar, listview];
}

inputbar {
  background-color: @black;
  border-color: @white;

  border: 2px;
  border-radius: 16px;

  padding: 8px 16px;
  spacing: 8px;
  children: [prompt, entry];
}

textbox {
  padding: 8px 24px;
}

listview {
  margin: 12px 0 0;
  lines: 8;
  columns: 1;
  fixed-height: false;
}

element {
  padding: 8px 16px;
  spacing: 8px;
  border-radius: 16px;
  children: [element-icon, element-text];
}

element-icon {
  size: 1em;
  vertical-align: 0.5;
}

element-text selected {
  text-color: @gray;
}
